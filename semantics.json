          "min": 10,
          "max": 600,
          "step": 10
        },
        {
          "name": "answers",
          "type": "list",
          "label": "Answers",
          "entity": "Answer",
          "min": 2,
          "field": {
            "name": "answer",
            "type": "group",
            "label": "Answer",
            "fields": [
              {
                "name": "answerText",
