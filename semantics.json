          "options": [
            {
              "value": "singleChoice",
              "label": "Single choice"
            },
            {
              "value": "multipleChoice",
              "label": "Multiple choice"
            },
            {
              "value": "trueFalse",
              "label": "True / False"
            },
            {
              "value": "freeText",
              "label": "Free response"
            }
          ]
        },
        {
          "name": "timeLimit",
          "type": "number",
          "label": "Time limit (seconds)",
