                "label": "Answer text",
                "importance": "high"
              },
              {
                "name": "correct",
                "type": "boolean",
                "label": "Correct answer",
                "default": false
              }
            ]
          }
        },
        {
          "name": "trueFalseAnswer",
          "type": "select",
          "label": "Correct True / False answer",
          "default": "true",
          "options": [
            {
              "value": "true",
              "label": "True"
            },
            {
              "value": "false",
              "label": "False"
            }
          ]
        },
        {
          "name": "expectedAnswer",
          "type": "text",
