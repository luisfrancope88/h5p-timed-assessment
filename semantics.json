[
  {
    "name": "assessmentTitle",
    "type": "text",
    "label": "Assessment title",
    "default": "Timed Assessment"
  },
  {
    "name": "questions",
    "type": "list",
    "label": "Questions",
    "importance": "high",
    "entity": "Question",
    "min": 1,
    "field": {
      "name": "question",
      "type": "group",
      "label": "Question",
      "fields": [
        {
          "name": "questionText",
          "type": "text",
          "label": "Question text",
          "importance": "high"
        },
        {
          "name": "questionType",
          "type": "select",
          "label": "Question type",
          "default": "singleChoice",
          "options": [
            {
              "value": "singleChoice",
              "label": "Single choice"
            },
            {
              "value": "multipleChoice",
              "label": "Multiple choice"
            },
            {
              "value": "trueFalse",
              "label": "True / False"
            },
            {
              "value": "freeText",
              "label": "Free response"
            }
          ]
        },
        {
          "name": "timeLimit",
          "type": "number",
          "label": "Time limit (seconds)",
          "description": "Maximum time allowed for this question.",
          "default": 60,
          "min": 10,
          "max": 600,
          "step": 10
        },
        {
          "name": "answers",
          "type": "list",
          "label": "Answers",
          "entity": "Answer",
          "min": 2,
          "field": {
            "name": "answer",
            "type": "group",
            "label": "Answer",
            "fields": [
              {
                "name": "answerText",
                "type": "text",
                "label": "Answer text",
                "importance": "high"
              },
              {
                "name": "correct",
                "type": "boolean",
                "label": "Correct answer",
                "default": false
              }
            ]
          }
        },
        {
          "name": "trueFalseAnswer",
          "type": "select",
          "label": "Correct True / False answer",
          "default": "true",
          "options": [
            {
              "value": "true",
              "label": "True"
            },
            {
              "value": "false",
              "label": "False"
            }
          ]
        },

        {
          "name": "acceptedAnswers",
          "type": "list",
          "label": "Accepted answers",
          "description": "Add all answers that should be considered correct.",
          "optional": true,
          "entity": "Accepted answer",
          "min": 1,
          "field": {
            "name": "acceptedAnswer",
            "type": "text",
            "label": "Answer"
          }
        }
        
      ]
    }
    },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behaviour",
    "importance": "high",
    "fields": [
      {
        "name": "passingScore",
        "type": "number",
        "label": "Passing score (%)",
        "description": "Percentage required to pass the assessment.",
        "default": 50,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "showFinalScore",
        "type": "boolean",
        "label": "Show final score",
        "default": true
      },
      {
        "name": "showScoreAfterQuestion",
        "type": "boolean",
        "label": "Show score after each question",
        "description": "Show the learner whether the question was answered correctly before continuing.",
        "default": false
      },

      {
        "name": "autoContinue",
        "type": "boolean",
        "label": "Automatically continue to the next question",
        "description": "Automatically proceed to the next hidden question after checking the answer.",
        "default": true
      },
      {
        "name": "autoContinueDelay",
        "type": "number",
        "label": "Delay before continuing (milliseconds)",
        "description": "Time the question score remains visible before proceeding to the next hidden question.",
        "default": 1500,
        "min": 500,
        "max": 10000,
        "step": 500
      },
      {
        "name": "showLearnerAnswers",
        "type": "boolean",
        "label": "Show learner answers in the final results",
        "default": true
      },
      {
        "name": "showCorrectAnswers",
        "type": "boolean",
        "label": "Show correct answers in the final results",
        "default": true
      }
    ]
  }
]